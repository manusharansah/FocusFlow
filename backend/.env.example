# Copy to .env and fill in. NEVER commit .env.
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.example.com
# Public URL of the SPA (used for redirects, CORS, Stripe return URLs, e-mail links)
FRONTEND_URL=https://app.example.com
# Public URL of this API (used by OAuth callbacks)
BACKEND_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
# Hard-to-guess admin path, no leading/trailing slash
ADMIN_URL=change-me-admin
# Postgres in production. Leave empty in dev to use SQLite.
DATABASE_URL=postgres://focusflow:password@db:5432/focusflow
# Optional shared cache (rate limits across workers): redis://redis:6379/1
REDIS_URL=
# Set True only behind a TLS-terminating proxy that sets X-Forwarded-Proto
BEHIND_PROXY=True
SECURE_SSL_REDIRECT=True

# Stripe  (Dashboard > Developers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_AUTOMATIC_TAX=False

# Google sign-in (Google Cloud Console > Credentials > OAuth client)
# Redirect URI: {BACKEND_URL}/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (verification + password reset). Dev default prints to console.
EMAIL_URL=
DEFAULT_FROM_EMAIL=FocusFlow <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Optional error tracking
SENTRY_DSN=
