# Builds the SPA and bakes it into the Caddy image, so one image is the whole public edge.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/build /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
