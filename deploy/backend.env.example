# Copy to deploy/backend.env. Values that depend on the domain are set by docker-compose.prod.yml.
SECRET_KEY=
DEBUG=False
ADMIN_URL=change-me-to-a-secret-path
# Email (verification + password reset). Required in production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FocusFlow <no-reply@your-domain>
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_AUTOMATIC_TAX=False
# Google sign-in (see docs/GOOGLE_SIGNIN.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_DSN=
