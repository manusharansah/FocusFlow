# Caddy is the only public service. It terminates HTTPS (automatic Let's Encrypt certificate for {$DOMAIN}),
# serves the built SPA, and proxies the API. Caddy is the first proxy, so the API sees the real client IP
# (NUM_PROXIES=1).
{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# form-action allows the redirect to Google for sign-in.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; object-src 'none'"
		-Server
	}

	# Only these paths reach Django. allauth's HTML account pages and the admin are NOT exposed here.
	@api path /api/* /static/*
	handle @api {
		reverse_proxy backend:8000
	}
	@google path /accounts/google/* /accounts/3rdparty/*
	handle @google {
		reverse_proxy backend:8000
	}
	# Optional: expose the Django admin on a secret path (set ADMIN_URL in the API env and uncomment).
	# @admin path /{$ADMIN_URL}/*
	# handle @admin { reverse_proxy backend:8000 }

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
